{
  "rules": {
    ".read": false,
    ".write": false,
    "share": {
      "$token": {
        ".write": "$token.length >= 32 && newData.exists() && (!data.exists() || data.child('k').val() === newData.child('k').val())",
        "k": { ".validate": "newData.isString() && newData.val().length >= 20 && newData.val().length <= 64" },
        "pub": {
          ".read": "$token.length >= 32",
          ".validate": "newData.hasChildren(['t'])",
          "t": { ".validate": "newData.isNumber()" },
          "la": { ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90" },
          "lo": { ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180" },
          "ac": { ".validate": "newData.isNumber()" },
          "ok": { ".validate": "newData.isNumber()" },
          "on": { ".validate": "newData.isBoolean()" },
          "name": { ".validate": "newData.isString() && newData.val().length <= 20" },
          "bus": { ".validate": "newData.isString() && (newData.val() === '1' || newData.val() === '2' || newData.val() === '3')" },
          "exp": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        },
        "$other": { ".validate": false }
      }
    },
    "photos": {
      ".read": true,
      ".indexOn": ["t"],
      "$id": {
        ".write": "newData.exists() && (!data.exists() || data.child('ownerKey').val() === newData.child('ownerKey').val())",
        ".validate": "newData.hasChildren(['t','ownerKey'])",
        "t": { ".validate": "newData.isNumber()" },
        "ownerKey": { ".validate": "newData.isString() && newData.val().length >= 20 && newData.val().length <= 64" },
        "name": { ".validate": "newData.isString() && newData.val().length <= 20" },
        "loc": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "cap": { ".validate": "newData.isString() && newData.val().length <= 80" },
        "img": { ".validate": "newData.isString() && newData.val().length <= 300000" },
        "del": { ".validate": "newData.isBoolean()" },
        "$other": { ".validate": false }
      }
    }
  }
}
